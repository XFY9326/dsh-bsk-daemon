{
  "name": "@xfy9326/dsh-bsk-daemon",
  "version": "1.0.0",
  "type": "module",
  "description": "DSH bundle that supervises the BrowserSkill (bsk) bridge daemon as a host child process: start with DSH, stop with DSH, bounded crash restarts. Windows, macOS and Linux.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "bundle",
    "browserskill",
    "bsk",
    "daemon",
    "browser-automation",
    "windows",
    "macos",
    "linux",
    "cross-platform"
  ],
  "license": "MIT",
  "author": "XFY9326",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XFY9326/dsh-bsk-daemon.git"
  },
  "homepage": "https://github.com/XFY9326/dsh-bsk-daemon#readme",
  "bugs": {
    "url": "https://github.com/XFY9326/dsh-bsk-daemon/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "cordis.patch.yml", "locale/*.json", "icon.svg"],
  "scripts": {
    "test": "node --test",
    "prepublishOnly": "node --test"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" }
  }
}
